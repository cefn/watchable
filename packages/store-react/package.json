{
  "name": "@watchable/store-react",
  "version": "1.0.0",
  "description": "Update React components when @watchable/store state changes",
  "homepage": "https://github.com/cefn/watchable/tree/main/packages/store-react#readme",
  "bugs": {
    "url": "https://github.com/cefn/watchable/issues?q=is%3Aissue+is%3Aopen+label%3Astore-react",
    "email": "watchable@cefn.com"
  },
  "repository": {
    "url": "https://github.com/cefn/watchable.git",
    "directory": "packages/store-react"
  },
  "license": "MIT",
  "author": "Cefn Hoile <github.com@cefn.com> (https://cefn.com)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "README.md",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "wireit",
    "lint": "wireit",
    "test": "wireit"
  },
  "dependencies": {
    "@watchable/store": "1.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^9.2.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/react": "^18.0.25",
    "@vitest/coverage-istanbul": "^1.6.0",
    "@vitest/coverage-v8": "^1.2.1",
    "jsdom": "^21.1.1",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vitest": "^1.6.0",
    "wireit": "^0.14.4"
  },
  "peerDependencies": {
    "@watchable/store": "1.0.0",
    "react": "^18.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "wireit": {
    "test": {
      "dependencies": [
        "build"
      ],
      "command": "vitest run --reporter verbose",
      "files": [
        "src/**/*",
        "test/**/*",
        "tsconfig.json",
        "tsconfig.test.json",
        "vite.config.ts"
      ],
      "output": [
        "./coverage"
      ]
    },
    "build": {
      "dependencies": [
        "../../packages/store:build"
      ],
      "command": "tsc --build && vite build",
      "files": [
        "src/**/*",
        "tsconfig.json",
        "vite.config.ts",
        "README.md"
      ],
      "output": [
        "./dist"
      ]
    },
    "lint": {
      "command": "eslint .",
      "files": [
        "**/*.js",
        "**/*.jsx",
        "**/*.ts",
        "**/*.jsx",
        "!dist/**/*",
        "!coverage/**/*"
      ],
      "output": [],
      "dependencies": [
        "build"
      ]
    }
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    }
  },
  "sideEffects": false
}
