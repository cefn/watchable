  "type": "module",
  "scripts": {
    "build": "wireit",
    "dev": "vite",
    "lint": "wireit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@watchable/store": "1.0.1",
    "@watchable/store-follow": "1.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-legacy": "^5.4.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "wireit": "^0.14.4"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "../../packages/store:build",
        "../../packages/store-follow:build"
      ],
      "command": "tsc --build && vite build",
      "files": [
        "src/**/*",
        "vite.config.ts",
        "../../tsconfig.base.json"
      ],
      "output": [
        "./dist"
      ]
    },
    "lint": {
      "command": "eslint .",
      "files": [
        "**/*.js",
        "**/*.jsx",
        "**/*.ts",
        "**/*.jsx",
        "!dist/**/*",
        "!coverage/**/*"
      ],
      "output": [],
      "dependencies": [
        "build"
      ]
    }
  }
}