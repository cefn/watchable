{
  "name": "counter-react-ts-edit-context",
  "version": "0.9.2",
  "private": true,
  "homepage": "https://github.com/cefn/watchable/tree/main/apps/counter-react-ts-edit-context#readme",
  "bugs": {
    "url": "https://github.com/cefn/watchable/issues?q=is%3Aissue+is%3Aopen+label%3Acounter-react-ts-edit-context",
    "email": "watchable@cefn.com"
  },
  "repository": {
    "url": "https://github.com/cefn/watchable.git",
    "directory": "apps/counter-react-ts-edit-context"
  },
  "license": "MIT",
  "author": "Cefn Hoile <github.com@cefn.com> (https://cefn.com)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:bundle": "run-s build preview",
    "build": "wireit",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:dev": "SERVER=http://localhost:5175 run-p --race dev test:server",
    "test:dev:bundle": "SERVER=http://localhost:4175 run-p --race dev:bundle test:server",
    "test:server": "wait-on --config waitOnConfig.json ${SERVER} && playwright test",
    "test": "wireit",
    "lint": "wireit"
  },
  "dependencies": {
    "@watchable/store": "1.0.2",
    "@watchable/store-edit": "1.0.2",
    "@watchable/store-react": "1.0.2",
    "immer": "^11.1.7",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-legacy": "^8.0.1",
    "@vitejs/plugin-react": "^6.0.1",
    "npm-run-all": "^4.1.5",
    "playwright-chromium": "^1.59.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.5",
    "wait-on": "^9.0.5",
    "wireit": "^0.14.12"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "../../packages/store:build",
        "../../packages/store-edit:build",
        "../../packages/store-react:build"
      ],
      "command": "tsc --build && vite build",
      "files": [
        "src/**/*",
        "vite.config.ts",
        "../../tsconfig.base.json"
      ],
      "output": [
        "./dist"
      ]
    },
    "test": {
      "dependencies": [
        "build",
        "../../packages/store:build",
        "../../packages/store-edit:build",
        "../../packages/store-react:build"
      ],
      "command": "run-s test:unit test:dev:bundle",
      "files": [
        "src/**/*",
        "test/**/*",
        "index.html",
        "playwright.config.ts",
        "tsconfig.json",
        "vite.config.ts",
        "waitOnConfig.json"
      ],
      "output": [
        "coverage",
        "playwright-report"
      ]
    },
    "lint": {
      "command": "eslint .",
      "files": [
        "**/*.js",
        "**/*.jsx",
        "**/*.ts",
        "**/*.jsx",
        "!dist/**/*",
        "!coverage/**/*"
      ],
      "output": [],
      "dependencies": [
        "build"
      ]
    }
  }
}